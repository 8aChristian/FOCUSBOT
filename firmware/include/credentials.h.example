#pragma once

// =============================================================================
// FOCUSBOT CREDENTIALS & LLM API CONFIGURATION
// =============================================================================
// 1. Copia este archivo y renómbralo a "credentials.h" en esta misma carpeta:
//    cp firmware/include/credentials.h.example firmware/include/credentials.h
// 2. Coloca aquí tu red Wi-Fi y tu API Key de tu proveedor de IA preferido
//    (OpenAI, Google Gemini, Anthropic Claude o servidor local Ollama / LM Studio).
// =============================================================================

// --- 1. CONEXIÓN WI-FI ---
#define FOCUSBOT_WIFI_SSID         "TU_RED_WIFI"
#define FOCUSBOT_WIFI_PASSWORD     "TU_PASSWORD_WIFI"

// --- 2. SELECCIÓN DE PROVEEDOR LLM ---
// Opciones: "OPENAI" | "GEMINI" | "CLAUDE" | "OLLAMA_LOCAL"
#define LLM_PROVIDER               "OPENAI"

// --- 3. API KEYS ---
// OpenAI API (gpt-4o-mini / gpt-4o / gpt-3.5-turbo):
#define OPENAI_API_KEY             "sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#define OPENAI_MODEL               "gpt-4o-mini"

// Google Gemini API (gemini-1.5-flash / gemini-2.0-flash):
#define GEMINI_API_KEY             "AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#define GEMINI_MODEL               "gemini-1.5-flash"

// Anthropic Claude API (claude-3-5-haiku / claude-3-5-sonnet):
#define CLAUDE_API_KEY             "sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxx"
#define CLAUDE_MODEL               "claude-3-5-haiku-20241022"

// Servidor Local (Ollama / vLLM / LM Studio en tu PC local):
#define LOCAL_LLM_HOST             "192.168.1.100"
#define LOCAL_LLM_PORT             11434
#define LOCAL_LLM_MODEL            "llama3.2:1b"

// --- 4. BLE COMPANION APP BRIDGE ---
// Si usas la App Móvil por Bluetooth (iOS/Android), la app se encarga de llamar
// al LLM usando tu cuenta o API Key en el teléfono, y transmite los comandos
// al FocusBot por BLE sin necesidad de Wi-Fi.
#define BLE_DEVICE_NAME            "FocusBot-Companion"
